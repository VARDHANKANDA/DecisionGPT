# ==============================================================================
# DecisionGPT Comprehensive .gitignore
# ==============================================================================

# Local Archive & Non-Public Reports
_LOCAL_ARCHIVE_NOT_FOR_GITHUB/
Project Report/
Project_Report/
*.docx
*.pdf

# Environment Configurations & Secrets (Never commit credentials)
.env
.env.*
!.env.example
!.env.test
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env.local
frontend/.env.*.local
frontend/.env
frontend/.env.*
!frontend/.env.example

# Credentials, Keys & Certificates
*.pem
*.key
*.p12
*.pfx
*.pkcs12
id_rsa
id_ed25519
*.crt
!deploy/staging/staging-root.crt

# Databases & Runtime Storage
backups_recovery/
*.db
*.sqlite
*.sqlite3
postgres-data/
dev.db
backend/dev.db
_eval_scratch*.db
backend/_eval_scratch*.db
.local/
data/business_uploads/
data/research_uploads/
data/external/*
!data/external/DATASET_REGISTRY.json
!data/external/india_context/
!data/external/india_context/**
!data/external/india_ecommerce/
!data/external/india_ecommerce/raw/
!data/external/india_ecommerce/raw/**
!data/external/india_ecommerce/processed/
!data/external/india_ecommerce/processed/**
!data/external/india_agmarknet/
!data/external/india_customer_synthetic/
!data/external/**/metadata.json
!data/external/**/metadata.md
!data/external/**/benchmark_results.json
data/external/india_customer_synthetic/raw/
data/external/india_customer_synthetic/processed/
data/external/india_agmarknet/raw/
data/external/india_agmarknet/processed/

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
ENV/
backend/.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
catboost_info/
coverage/
.coverage
.coverage.*

# Node & Next.js
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
.turbo/
frontend/.turbo/
*.tsbuildinfo
frontend/tsconfig.tsbuildinfo

# ML Binary Artifacts & Large Model Weights
*.pkl
*.joblib
!models/sales_forecast_naive/v1/model.joblib
!models/sales_forecast_linear/v1/model.joblib
!models/sales_forecast_xgboost/v1/model.joblib
!models/churn_logistic_regression/v1/model.joblib
!models/churn_random_forest/v1/model.joblib
!models/churn_xgboost/v1/model.joblib
mlruns/
wandb/

# Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.part
*~
.tools/
.formatting_fix_backup/
.claude/*
!.claude/launch.json

# Operating System & IDE Files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
