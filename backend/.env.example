# Copy to backend/.env for local development. backend/.env is git-ignored.

ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///./dev.db

# Frontend origin allowed by CORS.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# --- Authentication --------------------------------------------------------
# When true, every /businesses/** route requires a bearer token whose user
# owns that business, and /research/** requires an admin token (or the console
# token below). When false the API runs open (fastest for tests / a throwaway
# demo). The frontend expects this to be TRUE for the full sign-in experience.
AUTH_ENABLED=true
JWT_SECRET=change-me-jwt-secret

# --- Research console -----------------------------------------------------
# A signed-in user whose role is "admin" reaches the Research Console through
# the normal session (see backend/scripts/create_admin.py). This static token
# is a fallback for CI / scripts only.
RESEARCH_CONSOLE_ENABLED=true
RESEARCH_CONSOLE_TOKEN=change-me-research-console-token

# --- LLM (optional) ------------------------------------------------------
# Leave blank to run in deterministic template mode (llm_enabled = False).
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# --- Model registry ----------------------------------------------------
MODEL_REGISTRY_PATH=../models
