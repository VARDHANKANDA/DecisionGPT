# DecisionGPT Backend Environment Variables Template
# Copy to backend/.env and replace placeholders with production secrets

# ---- Environment & Secrets ----
ENVIRONMENT=production
LOG_LEVEL=INFO
# Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-a-real-secret-key-of-at-least-32-chars

# ---- Database (PostgreSQL required in production) ----
# Format: postgresql+psycopg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DBNAME>?sslmode=require
DATABASE_URL=postgresql+psycopg://decisiongpt_user:replace_with_password@postgres.render.com/decisiongpt?sslmode=require

# ---- CORS / Frontend Origin ----
# Comma-separated allowed https origins (no trailing slashes, no wildcards, no localhost in production)
FRONTEND_ORIGIN=https://decision-gpt.vercel.app

# ---- Authentication & JWT ----
AUTH_ENABLED=true
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-real-jwt-secret-of-at-least-32-chars
JWT_TTL_SECONDS=43200
JWT_ISSUER=decisiongpt
JWT_AUDIENCE=decisiongpt-api

# ---- Rate Limiting & Proxy Configuration ----
RATE_LIMIT_ENABLED=true
# On Render/Railway/Fly/Cloudflare, set to the proxy CIDR if trusting X-Forwarded-For:
# TRUSTED_PROXIES=

# ---- Research Platform & Console ----
RESEARCH_CONSOLE_ENABLED=true
# Generate with: openssl rand -hex 24
RESEARCH_CONSOLE_TOKEN=replace-with-a-real-research-token-24-chars

# ---- AI Provider (OpenAI) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANALYTICS_LLM_ENABLED=true
ANALYTICS_EXPLAIN_ENABLED=true

# ---- Storage (Persistent Disk or S3 / Cloudflare R2) ----
# Leave S3_BUCKET empty to store files on persistent local disk mount (/app/data)
# S3_BUCKET=decisiongpt-storage
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
