# ---- Application ----
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production

# ---- Database ----
POSTGRES_USER=decisiongpt
POSTGRES_PASSWORD=decisiongpt
POSTGRES_DB=decisiongpt
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://decisiongpt:decisiongpt@postgres:5432/decisiongpt

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# ---- LLM Provider (abstracted via LLMService) ----
# Leave empty to run in deterministic demo mode (no LLM calls).
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# ---- Research Console ----
RESEARCH_CONSOLE_ENABLED=true
RESEARCH_CONSOLE_TOKEN=change-me-research-console-token

# ---- Model Registry ----
MODEL_REGISTRY_PATH=/app/models
