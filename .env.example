# ---- Application ----
# development | test | staging | production. staging and production are HARDENED: the application refuses to start unless AUTH_ENABLED=true,
# JWT_SECRET / SECRET_KEY / RESEARCH_CONSOLE_TOKEN are real random values, DATABASE_URL is PostgreSQL with non-default credentials,
# FRONTEND_ORIGIN is an https origin and the database is migrated (alembic upgrade head). Any other value is rejected. See docs/PRODUCTION_SECURITY_REVIEW.md.
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production

# ---- Database ----
# Two PostgreSQL roles (docker-compose.yml, deploy/postgres/app-role.sql): POSTGRES_USER owns the schema and runs migrations; APP_DB_USER is the
# least-privilege role the API connects as. Both passwords are REQUIRED by docker compose and have no default; generate each with
# `openssl rand -hex 24` (hex needs no URL escaping). A hardened start (ENVIRONMENT=staging|production) refuses an API role that is a
# superuser or owns the tables.
POSTGRES_USER=decisiongpt_owner
POSTGRES_PASSWORD=
POSTGRES_DB=decisiongpt
APP_DB_USER=decisiongpt_app
APP_DB_PASSWORD=
# Outside docker compose (compose derives these two from the variables above):
# DATABASE_URL=postgresql+psycopg://<APP_DB_USER>:<APP_DB_PASSWORD>@<host>:5432/<POSTGRES_DB>
# MIGRATION_DATABASE_URL=postgresql+psycopg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@<host>:5432/<POSTGRES_DB>

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
FRONTEND_ORIGIN=http://localhost:3000

# ---- AI provider: OpenAI (the sole AI provider; official API, server-side only) ----
# Put your key after the = sign in backend/.env (git-ignored), never in frontend code or a tracked file.
# Leave OPENAI_API_KEY empty to run in deterministic rule-based mode (no network).
# OPENAI_MODEL must be a model your account can use that supports structured outputs; blank = the default (gpt-4.1-mini).
OPENAI_API_KEY=
OPENAI_MODEL=
# OPENAI_TIMEOUT_SECONDS=20
# OPENAI_MAX_RETRIES=1
# Optional plain-language restatement of an already-verified answer (a second OpenAI request, only for multi-row lists, only shown if it
# passes the deterministic repetition / number / claim guard). false = never send that request; the question is still understood by the
# model and every number is still calculated from your data. Server-side only; blank = true.
# ANALYTICS_EXPLAIN_ENABLED=true

# ---- Auth (Phase 4) ----
# AUTH_ENABLED=true requires a bearer token (from /api/v1/auth/login) on
# every /businesses/** and /research/** route. AUTH_ENABLED=false is for LOCAL DEVELOPMENT and isolated tests only: with it off any caller can
# read and write every business (the server logs a warning at startup). It is refused when ENVIRONMENT is staging or production.
AUTH_ENABLED=true
# DOCS_ENABLED= (blank: /docs and /openapi.json are on in development and test, off in staging and production)
JWT_SECRET=change-me-jwt-secret
JWT_TTL_SECONDS=43200
# Token claims and rotation. To rotate JWT_SECRET: put the OLD value in JWT_SECRET_PREVIOUS, set a new JWT_SECRET, restart, and remove
# JWT_SECRET_PREVIOUS after one JWT_TTL_SECONDS (tokens signed with it keep verifying until then; nothing is ever signed with it).
# JWT_ISSUER=decisiongpt
# JWT_AUDIENCE=decisiongpt-api
# JWT_SECRET_PREVIOUS=

# ---- Abuse protection (sign-in / sign-up / password change) ----
# Counters live in the database, so all workers and replicas share them. Required on in staging and production. Nothing locks an account: a
# limit only delays further attempts until its window ends. Defaults: 5 failed sign-ins per account+address, 20 per address and 40 per account
# in 15 minutes; 10 sign-ups per address per hour; 5 failed current-password checks per user in 15 minutes.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_LOGIN_PER_ACCOUNT_IP=5
# Client addresses: X-Forwarded-For is believed ONLY from these proxies (comma-separated IPs/CIDRs). Empty = never believed. Set it to your
# reverse proxy's address or network when, and only when, the API sits behind one you operate; otherwise every caller shares the proxy's address.
TRUSTED_PROXIES=

# ---- Research data uploads ----
RESEARCH_DATA_PATH=./data/research_uploads

# ---- Business data uploads ----
# Where the unchanged ORIGINAL of each uploaded CSV/.xlsx is kept (customer data: back it up with the database; git-ignored).
BUSINESS_UPLOAD_PATH=./data/business_uploads
# Largest file / most rows accepted per upload, and the share of rows that may be skipped before the whole import is refused.
MAX_UPLOAD_BYTES=26214400
MAX_UPLOAD_ROWS=200000
MAX_SKIPPED_ROW_SHARE=0.5

# ---- Research Console ----
RESEARCH_CONSOLE_ENABLED=true
RESEARCH_CONSOLE_TOKEN=change-me-research-console-token

# ---- Model Registry ----
MODEL_REGISTRY_PATH=/app/models

# ---- Cloud Object Storage (S3 / Cloudflare R2 / MinIO) ----
# Optional: if unconfigured, uploads and model artifacts use local persistent volumes.
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
