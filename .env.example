# ---- Application ----
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production

# ---- Database ----
POSTGRES_USER=decisiongpt
POSTGRES_PASSWORD=decisiongpt
POSTGRES_DB=decisiongpt
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://decisiongpt:decisiongpt@postgres:5432/decisiongpt

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# ---- LLM Provider (abstracted via LLMService) ----
# Leave LLM_API_KEY empty to run in deterministic template mode (no network).
# LLM_PROVIDER: openai | openai_compatible | anthropic
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30

# ---- Auth (Phase 4) ----
# AUTH_ENABLED=true requires a bearer token (from /api/v1/auth/login) on
# every /businesses/** and /research/** route.
AUTH_ENABLED=false
JWT_SECRET=change-me-jwt-secret
JWT_TTL_SECONDS=43200

# ---- Research data uploads ----
RESEARCH_DATA_PATH=./data/research_uploads

# ---- Research Console ----
RESEARCH_CONSOLE_ENABLED=true
RESEARCH_CONSOLE_TOKEN=change-me-research-console-token

# ---- Model Registry ----
MODEL_REGISTRY_PATH=/app/models
